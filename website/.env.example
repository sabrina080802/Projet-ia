# Frontend configuration (copy to website/.env, which is gitignored).
#
# Leave VITE_ENDPOINT empty to use the default "/predict", proxied by nginx to
# the dockerized backend. Override it only to target a different inference URL.
VITE_ENDPOINT=
# Optional. Only needed if the targeted endpoint enforces an API key.
# NEVER commit a real key: with Vite it is inlined into the public build.
VITE_API_KEY=
