# Copy this file to `.secrets.toml` and fill in your real credentials.
# `.secrets.toml` is gitignored and must never be committed.
# Generate the key at https://platform.ultralytics.com -> Settings -> API Keys.
# Platform keys look like `ul_` followed by 40 hex characters.

[ultralytics]
api_key = "YOUR_ULTRALYTICS_API_KEY"
